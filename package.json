    "allure-commandline": "^2.42.1",
    "allure-jest": "^3.10.0",
    "appium": "^3.5.0",
    "appium-uiautomator2-driver": "^7.5.2",
    "expect-webdriverio": "^5.6.7",
    "jest": "^30.4.2",
